<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFEAF2"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- TOP HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome\nback!"
                android:textSize="38sp"
                android:textStyle="bold"
                android:textColor="#D81B60" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Safety is our priority"
                android:textSize="15sp"
                android:textColor="#EC407A"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- LOGO - Bina file ke Gol -->
        <androidx.cardview.widget.CardView
            android:layout_width="90dp"
            android:layout_height="90dp"
            app:cardCornerRadius="45dp"
            app:cardBackgroundColor="#D81B60"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@android:drawable/ic_menu_myplaces"
                android:padding="20dp"
                android:tint="@android:color/white" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- 4 CARDS - Bina file ke Colourful -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:layout_marginTop="25dp">

        <!-- 1. PURPLE -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            app:cardCornerRadius="25dp"
            app:cardBackgroundColor="#6A1BFF"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="15dp" android:gravity="center">
                <ImageView android:layout_width="35dp" android:layout_height="35dp" android:src="@android:drawable/ic_menu_mylocation" android:tint="@android:color/white" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Live Location" android:textSize="22sp" android:textStyle="bold" android:textColor="@android:color/white" android:layout_marginTop="10dp" android:gravity="center" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 2. ORANGE -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            app:cardCornerRadius="25dp"
            app:cardBackgroundColor="#FF8A3D"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="15dp" android:gravity="center">
                <ImageView android:layout_width="35dp" android:layout_height="35dp" android:src="@android:drawable/ic_menu_call" android:tint="@android:color/white" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trusted Contacts" android:textSize="22sp" android:textStyle="bold" android:textColor="@android:color/white" android:layout_marginTop="10dp" android:gravity="center" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 3. BLUE -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            app:cardCornerRadius="25dp"
            app:cardBackgroundColor="#0097D6"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="15dp" android:gravity="center">
                <ImageView android:layout_width="35dp" android:layout_height="35dp" android:src="@android:drawable/ic_menu_call" android:tint="@android:color/white" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fake Calls" android:textSize="22sp" android:textStyle="bold" android:textColor="@android:color/white" android:layout_marginTop="10dp" android:gravity="center" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 4. GREEN -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            app:cardCornerRadius="25dp"
            app:cardBackgroundColor="#2ECC71"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="15dp" android:gravity="center">
                <ImageView android:layout_width="35dp" android:layout_height="35dp" android:src="@android:drawable/ic_menu_mapmode" android:tint="@android:color/white" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Safe Places" android:textSize="22sp" android:textStyle="bold" android:textColor="@android:color/white" android:layout_marginTop="10dp" android:gravity="center" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </GridLayout>

</LinearLayout>